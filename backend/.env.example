# 이 파일은 자동으로 로드되지 않습니다. 실제 서버에서는 환경변수로 설정하세요.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-secure-value
DJANGO_ALLOWED_HOSTS=13.124.201.48,127.0.0.1,localhost

# HTTPS 운영에서는 true로 설정하세요. 미설정 시 DJANGO_DEBUG=false에서 자동 활성화됩니다.
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true

# 로컬 SQLite 사용 시
DB_ENGINE=sqlite

# RDS MySQL 사용 시 DB_ENGINE=mysql로 바꾸고 아래 값을 설정하세요.
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password

# 참조 이미지 파일 저장 루트. Git 저장소 밖의 서버 전용 경로를 사용하세요.
BDM_IMAGE_ROOT=/home/ubuntu/data/necton/images

# RD-2 documents 테이블의 body_file_path/other_file_paths 기준 디렉터리.
# 운영 EC2의 원본 연구자료 저장 경로입니다.
RESEARCH_DOCUMENT_ROOT=/home/ubuntu/data/ingested_documents
